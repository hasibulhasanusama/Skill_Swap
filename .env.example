NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://skillswap:skillswap@localhost:5432/skillswap
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
STORAGE_DIR=./storage/private
DEMO_ENABLED=true

COMPLETION_RESPONSE_HOURS=72

PAYMENT_PROVIDER=sandbox
SANDBOX_ENABLED=true
COMMISSION_BPS=1000
SANDBOX_WEBHOOK_SECRET=replace-with-a-separate-32-character-random-value
SEED_FINANCE_DEMO=true
SEED_PROJECT_DEMO=true
SEED_ADMIN_DEMO=true
